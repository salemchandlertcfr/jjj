{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "subetapa",
    "modo",
    "dose",
    "pergunta",
    "decidir",
    "formato_entrega",
    "validacao_depois",
    "refuta_se",
    "restricoes",
    "versao_base",
    "rodadas"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "modo": {
      "enum": [
        "elaboracao",
        "verificacao",
        "integracao",
        "individual",
        "fusao",
        "avulso"
      ]
    },
    "dose": {
      "enum": [
        "leve",
        "padrao",
        "completa"
      ]
    },
    "rodadas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "pergunta": {
      "type": "string",
      "minLength": 1
    },
    "decidir": {
      "type": "array",
      "minItems": 1
    }
  }
}
